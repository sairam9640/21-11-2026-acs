# ==============================================================================
# AI ISP OS - Environment Configuration (Template)
# Copy this file to .env and replace placeholder values with your production secrets
# ==============================================================================

# 1. Server & Networking
NODE_ENV=production
PORT=4000
CWMP_PORT=7547
FRONTEND_PORT=80
APP_URL=https://acs.your-isp.net
CWMP_URL=http://acs.your-isp.net:7547
ACS_HOST=acs.your-isp.net
CORS_ORIGIN=https://acs.your-isp.net,https://admin.your-isp.net
DEMO_MODE=false

# 2. Database & Cache Connections
MONGODB_URI=mongodb://mongodb:27017/ai_isp_os_db
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=generate_a_secure_random_postgres_password_here

# 3. Security & Mandatory Cryptographic Secrets
# (In production, the backend refuses to boot if these remain unset or default)
JWT_SECRET=generate_a_random_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d
METRICS_BEARER_TOKEN=generate_a_secure_metrics_bearer_token_here
PAYMENT_SECRET_MASTER_KEY=generate_a_32_byte_aes_master_key_for_gateway_crypto
PAYMENT_SECRET_SALT=generate_a_random_salt_for_payment_scrypt_key_derivation

# 4. Webhook HMAC Validation Secrets
WHATSAPP_WEBHOOK_SECRET=generate_random_webhook_secret_for_whatsapp_events
STRIPE_WEBHOOK_SECRET=generate_random_webhook_secret_for_stripe_payments
RAZORPAY_WEBHOOK_SECRET=generate_random_webhook_secret_for_razorpay_payments

# 5. TR-069 CWMP Engine Settings
CWMP_REQUIRE_AUTH=true
CWMP_DEFAULT_PASSWORD=
ACS_FIRMWARE_BASE_URL=http://acs.your-isp.net:7547
CWMP_CONN_REQ_USER=acs_operator
CWMP_CONN_REQ_PASS=generate_secure_cpe_connection_request_password

# 6. WhatsApp Microservice (Evolution API v2)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=generate_a_secure_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=ai-isp-os

# 7. Initial Super Admin Account (Used on first database seed only)
SUPERADMIN_EMAIL=superadmin@your-isp.net
SUPERADMIN_PASSWORD=generate_a_very_strong_admin_password
SUPERADMIN_NAME=Super Administrator

# 8. External Integrations (Optional)
WHATSAPP_API_KEY=
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-isp.net
SMTP_PASS=
SMTP_FROM=support@your-isp.net
